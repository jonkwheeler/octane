{
  "$schema": "../example.schema.json",
  "schemaVersion": 1,
  "id": "next-islands",
  "title": "Next Islands",
  "summary": "A Next.js App Router shell incrementally hosting stateful TSRX, Recharts, and Tiptap leaves through OctaneCompat.",
  "status": "experimental",
  "host": "react",
  "renderModes": ["client", "static"],
  "dialects": ["tsrx", "tsx"],
  "bindings": ["@octanejs/recharts", "@octanejs/tiptap"],
  "octaneFeatures": ["next-host", "octane-compat", "react-host"],
  "commands": {
    "build": ["build"],
    "typecheck": "typecheck",
    "e2e": "test:e2e"
  },
  "journeys": [
    {
      "id": "react-shell-octane-leaf",
      "title": "Render a React-owned Next shell and update state inside its Octane leaf",
      "kind": "golden",
      "spec": "e2e/next-islands.spec.ts",
      "critical": true
    },
    {
      "id": "migrated-recharts-leaf",
      "title": "Render and update a converted Recharts chart inside the hosted Octane root",
      "kind": "golden",
      "spec": "e2e/next-islands.spec.ts",
      "critical": true
    },
    {
      "id": "migrated-tiptap-leaf",
      "title": "Render, replace, and edit Tiptap content inside the hosted Octane root",
      "kind": "golden",
      "spec": "e2e/next-islands.spec.ts",
      "critical": true
    }
  ],
  "faultScenarios": []
}
