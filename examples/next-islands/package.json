{
  "name": "next-islands-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "A Next.js App Router shell incrementally hosting an Octane TSRX island.",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "pnpm typecheck && next build --webpack",
    "build:turbopack": "pnpm typecheck && next build",
    "start": "next start",
    "typecheck": "tsrx-tsc --noEmit -p tsconfig.typecheck.json",
    "test:e2e": "pnpm build && playwright test --config e2e/playwright.config.ts"
  },
  "dependencies": {
    "@octanejs/recharts": "npm:@octanejs/recharts@0.1.15",
    "@octanejs/tiptap": "npm:@octanejs/tiptap@0.0.12",
    "@tiptap/starter-kit": "3.28.0",
    "next": "catalog:default",
    "octane": "npm:octane@0.1.18",
    "react": "catalog:default",
    "react-dom": "catalog:default"
  },
  "devDependencies": {
    "@octanejs/rspack-plugin": "workspace:*",
    "@playwright/test": "catalog:default",
    "@types/node": "catalog:default",
    "@types/react": "catalog:default",
    "@types/react-dom": "catalog:default",
    "typescript": "catalog:default"
  }
}
