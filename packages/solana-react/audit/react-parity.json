    {
      "id": "solana-react-missing-provider-error",
      "caseIds": [
        "runtime:081816f027c70cc0"
      ],
      "upstreamResult": "useClient throws SolanaError MISSING_PROVIDER with hookName context.",
      "octaneResult": "useClient throws a plain Error with message 'useClient must be used inside ClientProvider'.",
      "rationale": "The Octane binding keeps the public failure surface free of @solana/kit React error codes while preserving the must-be-under-provider contract.",
      "classification": "error-model",
      "consumerImpact": "Catch sites that match SolanaError codes must match the Error message instead.",
      "migrationGuidance": "Prefer try/catch on the message or a shared helper rather than SOLANA_ERROR__REACT__MISSING_PROVIDER.",
      "owner": "@octanejs/solana-react",
      "reviewCondition": "Review if Octane adopts SolanaError for binding-boundary failures."
    },
    {
      "id": "solana-react-capability-error",
      "caseIds": [
        "runtime:d19263abe251ae27",
        "runtime:ad59fa9b59c507a2"
      ],
      "upstreamResult": "useClientCapability throws SolanaError MISSING_CAPABILITY listing every missing capability.",
      "octaneResult": "useClientCapability throws a plain Error naming the first missing capability in the configured list.",
      "rationale": "Octane validates capabilities sequentially and surfaces a single actionable message without importing SolanaError into the public binding.",
      "classification": "error-model",
      "consumerImpact": "Callers that inspected SolanaError.context.capabilities see a message string instead.",
      "migrationGuidance": "Parse the Error message or check capabilities before calling the hook.",
      "owner": "@octanejs/solana-react",
      "reviewCondition": "Review if the binding starts returning SolanaError for capability failures."
    }
