{
  "name": "@octanejs/react-dropzone",
  "version": "0.1.20",
  "description": "Octane binding for react-dropzone 20.0.0",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "main": "./src/index.tsrx",
  "module": "./src/index.tsrx",
  "types": "./src/index.tsrx",
  "exports": {
    ".": {
      "types": "./src/index.tsrx",
      "import": "./src/index.tsrx",
      "require": "./src/index.tsrx"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md",
    "UPSTREAM.md",
    "LICENSE"
  ],
  "scripts": {
    "upstream:verify": "node audit/verify-provenance.mjs",
    "test:packed": "node tests/probes/packed-exports.test.mjs",
    "test:u2-parity": "node audit/verify-u2.mjs",
    "test:u3-parity": "node audit/verify-u3.mjs",
    "test:u4-parity": "node audit/verify-u4.mjs",
    "typecheck": "tsrx-tsc --noEmit -p tsconfig.json && tsrx-tsc --noEmit -p typetests/tsconfig.json"
  },
  "dependencies": {
    "attr-accept": "^2.2.5",
    "file-selector": "^4.1.0"
  },
  "peerDependencies": {
    "octane": "workspace:*"
  },
  "devDependencies": {
    "@octanejs/testing-library": "workspace:*",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.11",
    "@types/react-dom": "19.2.3",
    "octane": "workspace:*",
    "playwright": "catalog:default",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-dropzone": "20.0.0",
    "vite": "catalog:default"
  }
}
