{
  "name": "@octanejs/react-select",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "React Select bindings for the Octane renderer.",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/octanejs/octane.git",
    "directory": "packages/react-select"
  },
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src",
    "README.md",
    "UPSTREAM.md"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./base": "./src/base.ts",
    "./async": "./src/async.tsrx",
    "./animated": "./src/animated/index.ts",
    "./creatable": "./src/creatable.tsrx",
    "./async-creatable": "./src/async-creatable.tsrx"
  },
  "scripts": {
    "test": "pnpm upstream:verify && pnpm crosswalk:verify && pnpm test:octane",
    "test:octane": "vitest run --root ../.. --project react-select",
    "parity:inventory": "node ../../scripts/react-parity/react-select-runtime-inventory.mjs",
    "typecheck": "tsrx-tsc --noEmit -p tsconfig.json && tsrx-tsc --noEmit -p tests/browser/tsconfig.json && tsrx-tsc --noEmit -p typetests/tsconfig.local.json && tsrx-tsc --noEmit -p typetests/tsconfig.compat.json && tsc --noEmit -p typetests/tsconfig.upstream.json",
    "upstream:verify": "node scripts/verify-upstream.mjs",
    "crosswalk:verify": "node scripts/verify-crosswalk.mjs"
  },
  "dependencies": {
    "@octanejs/react-transition-group": "workspace:*",
    "@emotion/cache": "11.9.3",
    "@emotion/serialize": "1.1.0",
    "@emotion/utils": "1.2.0",
    "@floating-ui/dom": "1.8.0",
    "memoize-one": "6.0.0"
  },
  "peerDependencies": {
    "octane": "workspace:*"
  },
  "devDependencies": {
    "@emotion/react": "11.9.3",
    "@tsrx/react": "catalog:default",
    "happy-dom": "catalog:default",
    "octane": "workspace:*",
    "playwright": "catalog:default",
    "react": "catalog:default",
    "react-dom": "catalog:default",
    "react-select": "5.10.2",
    "use-isomorphic-layout-effect": "1.2.1",
    "vite": "catalog:default",
    "vitest": "catalog:default"
  },
  "engines": {
    "node": ">=22.22.2"
  }
}
