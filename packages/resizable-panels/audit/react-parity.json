      "consumerImpact": "Callers that relied on React's mocked ':r123:' test seam need Octane-specific id expectations.",
      "migrationGuidance": "Assert non-empty string (or an explicit id) rather than React's mocked ':r123:' when testing useId(undefined).",
      "owner": "@octanejs/resizable-panels",
      "reviewCondition": "Review if Octane gains a React-compatible useId mock seam or if upstream stops asserting mocked React.useId output."
