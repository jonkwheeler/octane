{
  "name": "@octanejs/opentui",
  "version": "0.0.1",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.22.2"
  },
  "octane": {
    "hookSlots": {
      "manual": [
        "src"
      ]
    }
  },
  "description": "OpenTUI bindings for Octane — terminal components, hooks, and a universal renderer over @opentui/core.",
  "author": {
    "name": "Dominic Gannaway",
    "email": "dg@domgan.com"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/octanejs/octane.git",
    "directory": "packages/opentui"
  },
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src",
    "README.md",
    "status.json"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config.ts",
    "./renderer": "./src/renderer.ts",
    "./intrinsics": "./src/intrinsics.ts",
    "./intrinsics/jsx-runtime": "./src/intrinsics.ts",
    "./test-utils": "./src/test-utils.ts"
  },
  "scripts": {
    "test": "bun ../../node_modules/vitest/vitest.mjs run --root ../.. --project opentui",
    "typecheck": "tsrx-tsc --noEmit"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.8 <0.6.0",
    "octane": "workspace:*"
  },
  "devDependencies": {
    "@opentui/core": "catalog:default",
    "octane": "workspace:*",
    "vitest": "catalog:default"
  }
}
