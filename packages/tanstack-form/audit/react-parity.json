  "divergences": [
    {
      "id": "tanstack-form-native-events",
      "caseIds": [
        "adapted:tanstack-form-native-event"
      ],
      "upstreamResult": "React text controls conventionally adapt synthetic onChange events into field values.",
      "octaneResult": "Octane text controls use native onInput events and pass values to field.handleChange.",
      "rationale": "Octane exposes native DOM events rather than React's synthetic event layer.",
      "classification": "event-model",
      "consumerImpact": "Form input handlers observe native event identity and lifecycle semantics.",
      "migrationGuidance": "Use onInput for native text controls; validator option names such as onChange remain unchanged.",
      "owner": "@octanejs/tanstack-form",
      "reviewCondition": "Review if Octane introduces React-compatible synthetic events."
    },
    {
      "id": "tanstack-form-id-lifecycle",
      "caseIds": [
        "adapted:tanstack-form-id-lifecycle"
      ],
      "upstreamResult": "The React adapter supports StrictMode effect replay and retains a legacy random-UUID fallback.",
      "octaneResult": "Octane always provides a stable useId value and does not double-invoke effects.",
      "rationale": "The host lifecycle and identifier facilities differ.",
      "classification": "component-model",
      "consumerImpact": "Forms keep one stable generated identity without StrictMode replay.",
      "migrationGuidance": "Do not rely on React StrictMode double invocation or random UUID fallback behavior.",
      "owner": "@octanejs/tanstack-form",
      "reviewCondition": "Review if Octane adopts StrictMode replay or removes guaranteed useId support."
    },
    {
      "id": "tanstack-form-function-components",
      "caseIds": [
        "adapted:tanstack-form-function-components"
      ],
      "upstreamResult": "React adapter component registration accepts React function and class component types.",
      "octaneResult": "Octane adapter registration accepts callable Octane function components only.",
      "rationale": "Octane does not implement the React class-component model.",
      "classification": "component-model",
      "consumerImpact": "Registered field and form components must be functions.",
      "migrationGuidance": "Convert registered class components to Octane function components.",
      "owner": "@octanejs/tanstack-form",
      "reviewCondition": "Review if Octane adds class-component compatibility."
    }
  ]
