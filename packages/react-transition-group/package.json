{
  "name": "@octanejs/react-transition-group",
  "version": "0.1.0",
  "license": "BSD-3-Clause",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.22.2"
  },
  "description": "React Transition Group-compatible transition components for Octane.",
  "author": {
    "name": "Dominic Gannaway",
    "email": "dg@domgan.com"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/octanejs/octane.git",
    "directory": "packages/react-transition-group"
  },
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src",
    "LICENSE",
    "README.md",
    "UPSTREAM.md",
    "status.json"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./Transition": "./src/Transition.tsrx",
    "./CSSTransition": "./src/CSSTransition.tsrx",
    "./TransitionGroup": "./src/TransitionGroup.tsrx",
    "./SwitchTransition": "./src/SwitchTransition.tsrx",
    "./ReplaceTransition": "./src/ReplaceTransition.tsrx",
    "./config": "./src/config.ts"
  },
  "scripts": {
    "test": "pnpm upstream:check && pnpm test:pristine && vitest run --root ../.. --project react-transition-group-adapted --project react-transition-group-adapted-ssr --project react-transition-group --project react-transition-group-ssr",
    "test:pristine": "jest --config tests/upstream-jest.config.cjs --runInBand --no-watchman",
    "parity:inventory": "node ../../scripts/react-parity/react-transition-group-runtime-inventory.mjs",
    "upstream:check": "node audit/check-upstream.mjs",
    "typecheck": "tsrx-tsc --noEmit -p tsconfig.json && tsrx-tsc --noEmit -p typetests/tsconfig.local.json && tsc --noEmit -p typetests/tsconfig.upstream.json"
  },
  "peerDependencies": {
    "octane": "workspace:*"
  },
  "devDependencies": {
    "@babel/core": "catalog:default",
    "@babel/preset-env": "7.29.7",
    "@babel/preset-react": "7.29.7",
    "@octanejs/testing-library": "workspace:*",
    "@testing-library/react": "16.3.2",
    "@tsrx/react": "catalog:default",
    "@types/react": "catalog:default",
    "@types/react-dom": "catalog:default",
    "@types/react-transition-group": "catalog:default",
    "babel-jest": "30.4.1",
    "babel-plugin-add-module-exports": "^1.0.4",
    "dom-helpers": "5.2.1",
    "jest": "30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "octane": "workspace:*",
    "prop-types": "15.8.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-transition-group": "catalog:default",
    "typescript": "catalog:default",
    "vitest": "catalog:default"
  }
}
