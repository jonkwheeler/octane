{
  "name": "@octanejs/mantine-core",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "description": "Mantine core components for the Octane renderer.",
  "author": {
    "name": "Dominic Gannaway",
    "email": "dg@domgan.com"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/octanejs/octane.git",
    "directory": "packages/mantine-core"
  },
  "sideEffects": [
    "*.css"
  ],
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src",
    "styles",
    "styles.css",
    "styles.layer.css",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./styles.css",
    "./styles.layer.css": "./styles.layer.css",
    "./styles/*": "./styles/*"
  },
  "scripts": {
    "test": "vitest run --root ../.. --project mantine-core --project mantine-core-ssr"
  },
  "dependencies": {
    "@octanejs/floating-ui": "workspace:*",
    "@octanejs/mantine-hooks": "workspace:*",
    "@octanejs/number-format": "workspace:*",
    "clsx": "catalog:default",
    "type-fest": "catalog:default"
  },
  "peerDependencies": {
    "octane": "workspace:*"
  },
  "devDependencies": {
    "@mantine/core": "9.5.0",
    "@types/react": "catalog:default",
    "octane": "workspace:*",
    "react": "catalog:default",
    "vitest": "catalog:default"
  }
}
