      "id": "renderer-owned-drag-adaptations",
      "caseIds": [
        "adapted:dnd-kit-renderer-adaptations"
      ],
      "upstreamResult": "React accepts ordinary element children in DragOverlay and enables optimistic DOM sorting by default.",
      "octaneResult": "The binding distinguishes compiled child blocks from render props and omits the default optimistic sorting plugin.",
      "rationale": "Moving a host before application state commits can split an Octane renderer-owned keyed range.",
      "classification": "rendering",
      "consumerImpact": "Optimistic pre-commit sortable movement must be opted into explicitly, and overlay child plumbing follows Octane compilation semantics.",
      "migrationGuidance": "Commit sortable order in application state and pass explicit plugins only when their DOM ownership is safe.",
      "owner": "@octanejs/dnd-kit",
      "reviewCondition": "Review if Octane supports safe external movement of renderer-owned keyed ranges."
    }
