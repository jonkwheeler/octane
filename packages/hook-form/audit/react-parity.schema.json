{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://octanejs.dev/schemas/react-parity.schema.json",
  "title": "Bounded React parity evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "provenance": {
            "properties": { "verification": { "const": "verified" } },
            "required": ["verification"]
          }
        },
        "required": ["provenance"]
      },
      "then": {
        "properties": {
          "lanes": {
            "contains": {
              "properties": {
                "type": { "const": "pristine-upstream" },
                "oracle": { "const": "required" },
                "available": { "not": { "const": false } }
              },
              "required": ["type", "oracle"]
            }
          }
        }
      }
    }
  ],
  "required": ["schemaVersion", "provenance", "environments", "lanes", "divergences"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "$schema": { "type": "string" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo",
        "version",
        "commit",
        "sourceRoot",
        "testRoot",
        "license",
        "integrity",
        "verification"
      ],
      "properties": {
        "repo": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "sourceRoot": { "type": "string", "minLength": 1 },
        "testRoot": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "integrity": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "verification": { "enum": ["recorded-unverified", "verified"] }
      }
    },
    "environments": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node", "platform", "arch", "packageManager", "lockfile", "lockfileSha256"],
        "properties": {
          "node": { "type": "string", "minLength": 1 },
          "platform": { "type": "string", "minLength": 1 },
          "arch": { "type": "string", "minLength": 1 },
          "packageManager": { "type": "string", "minLength": 1 },
          "lockfile": { "type": "string", "minLength": 1 },
          "lockfileSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "lanes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "oracle", "environment", "project", "files"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "enum": ["pristine-upstream", "adapted-octane", "differential", "browser"] },
          "oracle": { "enum": ["required", "optional"] },
          "available": { "type": "boolean" },
          "environment": { "type": "string", "minLength": 1 },
          "project": { "type": "string", "minLength": 1 },
          "notes": { "type": "string" },
          "files": {
            "type": "array",
            "minItems": 1,
            "contains": {
              "type": "object",
              "required": ["role", "cases"],
              "properties": {
                "role": { "const": "test" },
                "cases": { "type": "array", "minItems": 1 }
              }
            },
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "role", "sha256"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "role": { "enum": ["test", "support"] },
                "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                "cases": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["id", "testName", "fullName"],
                    "properties": {
                      "id": { "type": "string", "minLength": 1 },
                      "testName": { "type": "string", "minLength": 1 },
                      "fullName": { "type": "string", "minLength": 1 }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "divergences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "caseIds",
          "upstreamResult",
          "octaneResult",
          "rationale",
          "owner",
          "reviewCondition"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "caseIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "upstreamResult": { "type": "string", "minLength": 1 },
          "octaneResult": { "type": "string", "minLength": 1 },
          "rationale": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "reviewCondition": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
