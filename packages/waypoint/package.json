{
  "name": "@octanejs/waypoint",
  "version": "0.0.1",
  "license": "MIT",
  "type": "module",
  "octane": {
    "hookSlots": {
      "manual": [
        "src"
      ]
    }
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "description": "react-waypoint for Octane.",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/octanejs/octane.git",
    "directory": "packages/waypoint"
  },
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src",
    "README.md",
    "UPSTREAM.md",
    "status.json"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run --root ../.. --config vitest.config.js --project waypoint",
    "typecheck": "tsrx-tsc --noEmit",
    "parity:inventory": "node ../../scripts/react-parity/waypoint-runtime-inventory.mjs",
    "parity:verify-upstream": "node ./scripts/verify-upstream.mjs"
  },
  "peerDependencies": {
    "octane": "workspace:*"
  },
  "devDependencies": {
    "@babel/runtime": "7.28.4",
    "@swc/core": "1.15.41",
    "@swc/jest": "0.2.39",
    "@types/react": "catalog:default",
    "consolidated-events": "2.0.2",
    "jest": "30.4.2",
    "octane": "workspace:*",
    "prop-types": "15.8.1",
    "@vitejs/plugin-react": "catalog:default",
    "jasmine-core": "5.12.0",
    "playwright": "catalog:default",
    "vite": "catalog:default",
    "react": "catalog:default",
    "react-dom": "catalog:default",
    "react-is": "19.2.3",
    "react-test-renderer": "19.2.3",
    "react-waypoint": "10.3.0",
    "vitest": "catalog:default"
  }
}
