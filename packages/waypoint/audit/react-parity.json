	"divergences": [
		{
			"id": "waypoint-ref-child-contract",
			"caseIds": [
				"runtime:0f5696c86cdcf34e",
				"runtime:3098ae49fcaaf40e"
			],
			"upstreamResult": "Waypoint throws ensureRefIsUsedByChild when a custom child omits a ref.",
			"octaneResult": "Missing child refs do not throw; Octane uses refs-as-props without the upstream forwardRef detection branch.",
			"rationale": "Octane has no forwardRef and treats ref as an ordinary prop, so the upstream child-ref enforcement API does not apply.",
			"classification": "api-surface",
			"consumerImpact": "A child that forgets to forward ref mounts without the upstream development-time throw.",
			"migrationGuidance": "Forward the Waypoint-provided ref onto a host node when the child must participate in geometry measurement.",
			"owner": "@octanejs/waypoint",
			"reviewCondition": "Review if Octane adds a forwardRef-compatible child ref enforcement path."
		},
		{
			"id": "waypoint-onenter-state-update",
			"caseIds": [
				"runtime:182f948578b98575"
			],
			"upstreamResult": "Class Wrapper calls this.forceUpdate() from onEnter to re-render during the enter smoke case.",
			"octaneResult": "Function Wrapper bumps useState from onEnter; onEnter still fires only once.",
			"rationale": "Octane has no class components or forceUpdate; an explicit state bump is the equivalent re-render trigger.",
			"classification": "api-surface",
			"consumerImpact": "Consumers that relied on forceUpdate inside onEnter should use a state update instead.",
			"migrationGuidance": "Replace forceUpdate in onEnter with a useState (or equivalent) update.",
			"owner": "@octanejs/waypoint",
			"reviewCondition": "Review if Octane adds a forceUpdate-compatible imperative re-render API for function components."
		}
	]
