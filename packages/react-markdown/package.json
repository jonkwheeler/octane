{
  "name": "@octanejs/react-markdown",
  "version": "0.1.20",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "description": "react-markdown 10.1.0 bindings for Octane",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/octanejs/octane.git",
    "directory": "packages/react-markdown"
  },
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src",
    "README.md",
    "UPSTREAM.md"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "pnpm upstream:verify && vitest run --config tsconfig.json --root . tests/probes/async-component.server.test.ts tests/adoption/consumer.test.ts tests/differential tests/validation.test.ts",
    "test:architecture": "vitest run --config tsconfig.json --root . tests/probes/async-component.server.test.ts",
    "upstream:verify": "node audit/verify-provenance.mjs --self-test",
    "typecheck": "tsrx-tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@types/hast": "^3.0.0",
    "@types/mdast": "^4.0.0",
    "devlop": "^1.0.0",
    "hast-util-to-jsx-runtime": "^2.0.0",
    "html-url-attributes": "^3.0.0",
    "mdast-util-to-hast": "^13.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.0.0",
    "unified": "^11.0.0",
    "unist-util-visit": "^5.0.0",
    "vfile": "^6.0.0"
  },
  "peerDependencies": {
    "octane": "workspace:*"
  },
  "devDependencies": {
    "@octanejs/testing-library": "workspace:*",
    "@testing-library/react": "16.3.2",
    "@types/node": "catalog:default",
    "@types/react": "catalog:default",
    "@types/react-dom": "catalog:default",
    "@tsrx/react": "catalog:default",
    "octane": "workspace:*",
    "react": "catalog:default",
    "react-dom": "catalog:default",
    "react-markdown": "10.1.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "vitest": "catalog:default"
  }
}
