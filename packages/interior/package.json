{
  "name": "@octanejs/interior",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "description": "Interior for the octane renderer — Octane ports of interior.dev copy-paste React components.",
  "author": {
    "name": "Dominic Gannaway",
    "email": "dg@domgan.com"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/octanejs/octane.git",
    "directory": "packages/interior"
  },
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "octane": {
    "hookSlots": {
      "manual": ["src/hooks"]
    }
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run"
  },
  "peerDependencies": {
    "octane": "workspace:*",
    "@octanejs/motion": "workspace:*"
  },
  "dependencies": {
    "@octanejs/motion": "workspace:*"
  },
  "devDependencies": {
    "@octanejs/motion": "workspace:*",
    "@tsrx/react": "catalog:default",
    "esbuild": "catalog:default",
    "octane": "workspace:*",
    "react": "catalog:default",
    "react-dom": "catalog:default",
    "vitest": "catalog:default"
  }
}
