{
  "name": "@octanejs/react-resizable-panels",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "description": "Octane port of react-resizable-panels 4.12.2.",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/octanejs/octane.git",
    "directory": "packages/react-resizable-panels"
  },
  "main": "src/index.tsrx",
  "module": "src/index.tsrx",
  "types": "src/index.tsrx",
  "files": [
    "src",
    "README.md",
    "UPSTREAM.md"
  ],
  "exports": {
    ".": "./src/index.tsrx"
  },
  "scripts": {
    "test": "pnpm upstream:verify && vitest run --root ../.. --project react-resizable-panels && vitest run --root ../.. --project react-resizable-panels-server && vitest run --root ../.. --project react-resizable-panels-pristine && vitest run --root ../.. --project react-resizable-panels-browser",
    "test:upstream": "vitest run --config upstream/source/vitest.config.ts",
    "upstream:verify": "node audit/verify-provenance.mjs",
    "upstream:verify:negative-controls": "node audit/verify-provenance.mjs --negative-controls",
    "typecheck:probes": "tsrx-tsc --noEmit -p audit/type-probes/tsconfig.json",
    "typecheck": "tsrx-tsc --noEmit -p tsconfig.json && tsrx-tsc --noEmit -p typetests/tsconfig.json"
  },
  "peerDependencies": {
    "octane": "workspace:*"
  },
  "devDependencies": {
    "@octanejs/testing-library": "workspace:*",
    "@testing-library/jest-dom": "catalog:default",
    "@testing-library/react": "catalog:default",
    "@types/react": "catalog:default",
    "@types/react-dom": "catalog:default",
    "@tsrx/react": "catalog:default",
    "octane": "workspace:*",
    "jsdom": "26.1.0",
    "playwright": "catalog:default",
    "react": "catalog:default",
    "react-dom": "catalog:default",
    "react-resizable-panels": "catalog:default",
    "vite": "catalog:default",
    "vitest": "catalog:default"
  }
}
