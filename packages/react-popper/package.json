{
  "name": "@octanejs/react-popper",
  "version": "0.0.1",
  "description": "Exact Octane binding for react-popper 2.3.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "octane": {
    "hookSlots": {
      "manual": [
        "src"
      ]
    }
  },
  "author": {
    "name": "Dominic Gannaway",
    "email": "dg@domgan.com"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/octanejs/octane.git",
    "directory": "packages/react-popper"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src",
    "README.md",
    "UPSTREAM.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "pnpm upstream:verify && pnpm test:audit && pnpm typecheck && vitest run --root ../.. --project react-popper --project react-popper-ssr --project react-popper-hydration --project react-popper-differential",
    "upstream:verify": "node audit/upstream-inventory.mjs",
    "test:audit": "node --test tests/audit/upstream-inventory.test.mjs",
    "typecheck": "tsrx-tsc --noEmit -p tsconfig.json && tsrx-tsc --noEmit -p typetests/tsconfig.adapted.json && tsc --noEmit -p typetests/tsconfig.pristine.json"
  },
  "dependencies": {
    "react-fast-compare": "^3.2.2"
  },
  "peerDependencies": {
    "@popperjs/core": "^2.0.0",
    "octane": "workspace:*"
  },
  "devDependencies": {
    "@popperjs/core": "2.11.8",
    "@tsrx/react": "catalog:default",
    "@types/react": "catalog:default",
    "@types/react-dom": "catalog:default",
    "octane": "workspace:*",
    "playwright": "catalog:default",
    "react": "catalog:default",
    "react-dom": "catalog:default",
    "react-popper": "2.3.0",
    "vite": "catalog:default",
    "vitest": "catalog:default"
  }
}
