{
  "name": "@octanejs/mantine-notifications",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "description": "Mantine notifications for Octane.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/octanejs/octane.git",
    "directory": "packages/mantine-notifications"
  },
  "publishConfig": { "access": "public" },
  "sideEffects": ["*.css"],
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "files": ["src", "styles.css", "styles.layer.css", "README.md"],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./styles.css",
    "./styles.layer.css": "./styles.layer.css"
  },
  "scripts": { "test": "vitest run --root ../.. --project mantine-notifications" },
  "dependencies": {
    "@octanejs/mantine-core": "workspace:*",
    "@octanejs/mantine-hooks": "workspace:*",
    "@octanejs/mantine-store": "workspace:*"
  },
  "peerDependencies": { "octane": "workspace:*" },
  "devDependencies": {
    "@mantine/notifications": "9.5.0",
    "@types/react": "catalog:default",
    "octane": "workspace:*",
    "vitest": "catalog:default"
  }
