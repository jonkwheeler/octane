  "divergences": [
    {
      "id": "core-version",
      "caseIds": ["audit:core-version"],
      "upstreamResult": "The pinned React adapter publishes with @tanstack/devtools 0.12.4 (from @tanstack/react-devtools package.json).",
      "octaneResult": "The Octane package resolves @tanstack/devtools from the workspace catalog (currently 0.12.5).",
      "rationale": "The workspace catalog had advanced before this audit; silently downgrading the shared core is outside this harness PR.",
      "classification": "dependency",
      "consumerImpact": "Core behavior may include patch-level changes beyond the pinned React adapter.",
      "migrationGuidance": "Review 0.12.4 to 0.12.5 core changes when exact-version parity is required.",
      "owner": "@octanejs/tanstack-devtools",
      "reviewCondition": "Remove when both adapters resolve the same core version."
    },
    {
      "id": "octane-type-names",
      "caseIds": ["types:adapted-octane-compile"],
      "upstreamResult": "Adapter types are named TanStackDevtoolsReactPlugin and TanStackDevtoolsReactInit.",
      "octaneResult": "Adapter types are named TanStackDevtoolsOctanePlugin and TanStackDevtoolsOctaneInit.",
      "rationale": "Framework-specific public type names identify the runtime they describe.",
      "classification": "types",
      "consumerImpact": "Type-only imports require renamed symbols.",
      "migrationGuidance": "Rename ReactPlugin/ReactInit imports to OctanePlugin/OctaneInit.",
      "owner": "@octanejs/tanstack-devtools",
      "reviewCondition": "Review if framework-neutral aliases are introduced."
    },
    {
      "id": "extra-core-reexports",
      "caseIds": ["audit:extra-core-reexports"],
      "upstreamResult": "The React adapter exports only the component and React adapter types.",
      "octaneResult": "Octane additionally re-exports framework-neutral core values and types.",
      "rationale": "Existing Octane consumers use the binding as the plugin-authoring type boundary.",
      "classification": "api",
      "consumerImpact": "Octane has an additive public surface.",
      "migrationGuidance": "React-targeted code should import these symbols from @tanstack/devtools directly.",
      "owner": "@octanejs/tanstack-devtools",
      "reviewCondition": "Review if the additive exports are removed or upstream adds them."
    }
  ]
