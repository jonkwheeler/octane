    {
      "id": "react-pdf-octane-node-ref-event-types",
      "caseIds": ["differential:react-pdf-document-shells"],
      "upstreamResult": "React's public declarations use ReactNode, React ref types, synthetic event types, and React CSS property types.",
      "octaneResult": "The binding declares OctaneNode, refs-as-props, native DOM events, and Octane class/style values.",
      "rationale": "Octane deliberately exposes native event and ref-prop contracts instead of React's synthetic and forwardRef-oriented types.",
      "classification": "intentional-framework-divergence",
      "consumerImpact": "Type-only React node, ref, event, and CSS annotations need Octane equivalents when migrating an application.",
      "migrationGuidance": "Use OctaneNode, plain ref props, native event types, and Octane-supported class/style values.",
      "owner": "@octanejs/react-pdf",
      "reviewCondition": "Revisit if Octane adopts a compatibility type layer without changing native runtime semantics."
    },
    {
      "id": "react-pdf-star-export-surface",
      "caseIds": ["types:react-pdf-adapted"],
      "upstreamResult": "The upstream package's permissive wildcard exposes implementation and source artifacts through undocumented deep imports.",
      "octaneResult": "The binding supports only the root entry point and the two documented CSS subpaths.",
      "rationale": "Framework-private upstream implementation artifacts are pinned as audit evidence, not public Octane API.",
      "classification": "intentional-public-surface-divergence",
      "consumerImpact": "Consumers relying on undocumented react-pdf deep imports must migrate to documented root exports or CSS paths.",
      "migrationGuidance": "Import public symbols from @octanejs/react-pdf and styles only from the documented CSS subpaths.",
      "owner": "@octanejs/react-pdf",
      "reviewCondition": "Revisit only when a documented upstream subpath becomes a supported binding export."
    }
