{
  "name": "@octanejs/react-window",
  "version": "0.0.1",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "description": "Exact Octane binding for react-window 2.3.0.",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src",
    "README.md",
    "UPSTREAM.md",
    "LICENSE.md"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "adapted:generate": "node tests/generate-adapted-tests.mjs",
    "upstream:verify": "node tests/audit/verify-upstream.mjs",
    "test:audit": "node --test tests/audit/*.test.mjs",
    "test:types:pristine": "tsc --noEmit -p typetests/tsconfig.pristine.json",
    "test:types:adapted": "tsrx-tsc --noEmit -p typetests/tsconfig.adapted.json",
    "typecheck": "tsrx-tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@types/react": "catalog:default"
  },
  "peerDependencies": {
    "octane": "workspace:*"
  },
  "devDependencies": {
    "@octanejs/testing-library": "workspace:*",
    "@testing-library/jest-dom": "catalog:default",
    "@testing-library/react": "16.3.2",
    "@tsrx/react": "catalog:default",
    "octane": "workspace:*",
    "react": "catalog:default",
    "react-dom": "catalog:default",
    "react-window": "2.3.0"
  }
}
