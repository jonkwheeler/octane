      "id": "react-window-component-call-abi",
      "caseIds": ["runtime:react-window-adapted-048", "runtime:react-window-adapted-049"],
      "upstreamResult": "React invokes function components with public props and an undefined legacy second argument.",
      "octaneResult": "Octane invokes compiled components with the same public props and reserves the second argument for its internal block ABI.",
      "rationale": "The second argument is renderer plumbing, not part of the component's public consumer contract.",
      "classification": "framework-abi",
      "consumerImpact": "Mocks that assert the complete raw component invocation tuple observe an Octane internal object as the second argument.",
      "migrationGuidance": "Assert component props or rendered behavior instead of React's undocumented second invocation argument.",
      "owner": "@octanejs/react-window",
      "reviewCondition": "Review if Octane removes the internal component block argument or React changes its component invocation ABI."
    },
    {
      "id": "react-window-keyed-effect-order",
      "caseIds": ["runtime:react-window-adapted-004", "runtime:react-window-adapted-054"],
      "upstreamResult": "React reruns keyed child effects in new visual order, including an unchanged center List row.",
      "octaneResult": "Octane preserves the same keyed state and DOM identity but may run moved effects in prior block order and memoize an unchanged center row.",
      "rationale": "Effect scheduling order and equal-prop memoization are renderer-specific while keyed state identity is the public behavior under test.",
      "classification": "scheduling",
      "consumerImpact": "Effect-log order and render-count assertions may differ after reversing keyed rows while visible content and state identity remain equal.",
      "migrationGuidance": "Do not depend on sibling effect ordering or rerenders of equal-prop keyed children; assert identity and final rendered state.",
      "owner": "@octanejs/react-window",
      "reviewCondition": "Review if Octane changes keyed reconciliation or effect scheduling semantics."
    }
