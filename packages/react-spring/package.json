{
  "name": "@octanejs/react-spring",
  "version": "0.0.1",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "octane": {
    "hookSlots": {
      "manual": [
        "src"
      ]
    }
  },
  "description": "React Spring web bindings for Octane.",
  "author": {
    "name": "Dominic Gannaway",
    "email": "dg@domgan.com"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/octanejs/octane.git",
    "directory": "packages/react-spring"
  },
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src",
    "README.md",
    "UPSTREAM.md"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./parallax": "./src/parallax.ts"
  },
  "scripts": {
    "test": "vitest run --project react-spring"
  },
  "dependencies": {
    "@react-spring/rafz": "10.1.2"
  },
  "peerDependencies": {
    "octane": "workspace:*"
  },
  "devDependencies": {
    "@react-spring/web": "catalog:default",
    "octane": "workspace:*",
    "vitest": "catalog:default"
  }
}
