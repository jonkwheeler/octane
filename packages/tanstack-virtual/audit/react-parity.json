      "id": "tanstack-virtual-nested-flush",
      "caseIds": [
        "adapted:tanstack-virtual-nested-flush"
      ],
      "upstreamResult": "React flushSync performs a synchronous nested flush for a sync virtualizer notification.",
      "octaneResult": "Octane degrades nested flushSync to a plain dispatch drained by the ambient discrete-event flush.",
      "rationale": "Octane prevents re-entrant flush stacks while retaining the same settled consumer-visible window.",
      "classification": "framework-integration",
      "consumerImpact": "The virtual window is current when the enclosing event flush returns; no extra consumer action is required.",
      "migrationGuidance": "None; observe virtualizer state after the event boundary rather than relying on React's nested flush implementation detail.",
      "owner": "@octanejs/tanstack-virtual",
      "reviewCondition": "Review if Octane changes re-entrant flush semantics."
    }
