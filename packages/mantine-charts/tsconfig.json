{
  "compilerOptions": {
    "module": "esnext",
    "lib": ["esnext", "dom", "dom.iterable"],
    "target": "esnext",
    "jsx": "react-jsx",
    "jsxImportSource": "octane",
    "noEmit": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "octane": ["../octane/dist/index.d.ts"],
      "octane/jsx-runtime": ["../octane/dist/jsx-runtime.d.ts"],
      "@octanejs/recharts": ["../recharts/src/index.d.ts"]
    },
    "noEmitOnError": true,
    "noErrorTruncation": true,
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "verbatimModuleSyntax": false,
    "types": ["node"],
    "strict": true
  },
  "include": ["./src/"],
  "exclude": ["node_modules", "dist", "tests", "typetests", "src/ChartBrush", "src/Treemap"]
}
