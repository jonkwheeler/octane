{
  "name": "@octanejs/react-textarea-autosize",
  "version": "0.1.0",
  "description": "react-textarea-autosize for Octane with matching measurement and lifecycle behavior.",
  "license": "MIT",
  "type": "module",
  "author": {
    "name": "Octane contributors"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/octanejs/octane.git",
    "directory": "packages/react-textarea-autosize"
  },
  "main": "src/index.tsrx",
  "module": "src/index.tsrx",
  "types": "src/index.tsrx",
  "files": ["src", "README.md", "UPSTREAM.md", "LICENSE"],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": {
        "import": "./src/index.tsrx",
        "default": "./src/index.tsrx"
      },
      "development": {
        "edge-light": {
          "module": "./src/index.tsrx",
          "import": "./src/index.tsrx",
          "default": "./src/index.tsrx"
        },
        "worker": {
          "module": "./src/index.tsrx",
          "import": "./src/index.tsrx",
          "default": "./src/index.tsrx"
        },
        "workerd": {
          "module": "./src/index.tsrx",
          "import": "./src/index.tsrx",
          "default": "./src/index.tsrx"
        },
        "browser": {
          "module": "./src/index.tsrx",
          "import": "./src/index.tsrx",
          "default": "./src/index.tsrx"
        },
        "module": "./src/index.tsrx",
        "import": "./src/index.tsrx",
        "default": "./src/index.tsrx"
      },
      "edge-light": {
        "module": "./src/index.tsrx",
        "import": "./src/index.tsrx",
        "default": "./src/index.tsrx"
      },
      "worker": {
        "module": "./src/index.tsrx",
        "import": "./src/index.tsrx",
        "default": "./src/index.tsrx"
      },
      "workerd": {
        "module": "./src/index.tsrx",
        "import": "./src/index.tsrx",
        "default": "./src/index.tsrx"
      },
      "browser": {
        "module": "./src/index.tsrx",
        "import": "./src/index.tsrx",
        "default": "./src/index.tsrx"
      },
      "module": "./src/index.tsrx",
      "import": "./src/index.tsrx",
      "default": "./src/index.tsrx"
    },
    "./package.json": "./package.json"
  },
  "imports": {
    "#is-development": {
      "development": "./src/conditions/true.ts",
      "default": "./src/conditions/false.ts"
    },
    "#is-browser": {
      "edge-light": "./src/conditions/false.ts",
      "workerd": "./src/conditions/false.ts",
      "worker": "./src/conditions/false.ts",
      "browser": "./src/conditions/true.ts",
      "default": "./src/conditions/is-browser.ts"
    }
  },
  "engines": {"node": ">=22"},
  "scripts": {
    "test": "vitest run --config vitest.config.ts --root .",
    "test:types": "tsrx-tsc -p tsconfig.json --noEmit",
    "verify:upstream": "node scripts/verify-upstream.mjs"
  },
  "peerDependencies": {"octane": "workspace:*"},
  "devDependencies": {
    "@types/node": "catalog:default",
    "@types/react": "catalog:default",
    "octane": "workspace:*",
    "react": "catalog:default",
    "react-dom": "catalog:default",
    "use-composed-ref": "1.3.0",
    "use-latest": "1.2.1",
    "typescript": "catalog:default",
    "vitest": "catalog:default"
  }
}
