  "divergences": [
    {
      "id": "react-colorful-native-event-attributes",
      "caseIds": [
        "differential:react-colorful-controlled",
        "types:react-colorful-adapted"
      ],
      "upstreamResult": "Picker and HexColorInput host prop types extend React synthetic DOM attribute types (InputHTMLAttributes / HTMLAttributes).",
      "octaneResult": "The same surfaces extend Octane intrinsic prop types, so residual host handlers such as onInput/onBlur use native DOM event attributes instead of React synthetic event types.",
      "rationale": "Octane has no synthetic event layer; native delegated events are the supported host contract while public color onChange callbacks remain unchanged.",
      "classification": "event-model",
      "consumerImpact": "Type-level host event handlers on pickers/inputs use native event types; runtime DOM events and color callback values still match upstream.",
      "migrationGuidance": "Keep binding color updates through the public onChange callback. When typing residual host handlers (for example HexColorInput onInput), use native DOM event types rather than React.ChangeEvent.",
      "owner": "@octanejs/react-colorful",
      "reviewCondition": "Review if Octane introduces a React-compatible synthetic event type layer for host attributes."
    }
  ]
