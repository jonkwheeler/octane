{
  "name": "@octanejs/intersection-observer",
  "version": "0.0.1",
  "license": "MIT",
  "type": "module",
  "octane": {
    "hookSlots": {
      "manual": [
        "src"
      ]
    }
  },
  "engines": {
    "node": ">=22"
  },
  "description": "react-intersection-observer for Octane.",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/octanejs/octane.git",
    "directory": "packages/intersection-observer"
  },
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src",
    "README.md",
    "UPSTREAM.md",
    "status.json"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./test-utils": "./src/test-utils.ts"
  },
  "scripts": {
    "test": "vitest run --root ../.. --config vitest.config.js --project intersection-observer",
    "typecheck": "tsrx-tsc --noEmit"
  },
  "peerDependencies": {
    "octane": "workspace:*"
  },
  "devDependencies": {
    "octane": "workspace:*",
    "react-intersection-observer": "10.1.0",
    "vitest": "catalog:default"
  }
}
